    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "date-fns": "4.1.0",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@activity-log/eslint-config": "workspace:*",
    "@activity-log/prettier-config": "workspace:*",
    "@activity-log/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:react19",
    "typescript": "catalog:",
    "vitest": "4.0.15"
  },
  "peerDependencies": {
    "react": "catalog:react19"
  },
  "prettier": "@activity-log/prettier-config"
}
