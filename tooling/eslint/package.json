{
  "name": "@activity-log/eslint-config",
  "private": true,
  "type": "module",
  "exports": {
    "./base": "./base.ts",
    "./react": "./react.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/compat": "1.4.1",
    "@eslint/js": "catalog:",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-turbo": "2.6.0",
    "typescript-eslint": "8.46.3"
  },
  "devDependencies": {
    "@activity-log/prettier-config": "workspace:*",
    "@activity-log/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@activity-log/prettier-config"
}
