{
  "name": "@activity-log/expo",
  "private": true,
  "version": "2.2.3",
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start --clear",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "build:dev": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "expo:fix": "expo install --check"
  },
  "dependencies": {
    "@activity-log/ui": "workspace:*",
    "@expo/ui": "~57.0.26",
    "@expo/vector-icons": "^15.1.1",
    "@legendapp/list": "^3.3.11",
    "date-fns": "4.1.0",
    "expo": "~57.0.33",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.21",
    "expo-blur": "^57.0.3",
    "expo-constants": "~57.0.24",
    "expo-dev-client": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.14",
    "expo-localization": "57.0.2",
    "expo-navigation-bar": "~57.0.3",
    "expo-router": "~57.0.31",
    "expo-sharing": "~57.0.26",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.28",
    "lodash": "^4.17.21",
    "nativewind": "5.0.0-rc.0",
    "papaparse": "^5.4.1",
    "posthog-react-native": "^4.46.21",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-hook-form": "7.62.0",
    "react-native": "~0.86.3",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "~15.15.3",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.3.1",
    "uuid": "^14.0.2",
    "zod": "4.1.12",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@activity-log/eslint-config": "workspace:*",
    "@activity-log/prettier-config": "workspace:*",
    "@activity-log/tailwind-config": "workspace:*",
    "@activity-log/tsconfig": "workspace:*",
    "@babel/core": "7.29.0",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.18",
    "@react-native/metro-config": "0.86.3",
    "@types/babel__core": "^7.20.5",
    "@types/lodash": "^4.17.16",
    "@types/papaparse": "^5.3.15",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@types/react-test-renderer": "19.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "18.0.8",
    "eslint": "catalog:",
    "lightningcss": "1.30.1",
    "prettier": "catalog:",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.0.15"
  },
  "prettier": "@activity-log/prettier-config",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
