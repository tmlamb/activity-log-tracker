{
  "name": "@activity-log/expo",
  "private": true,
  "version": "2.0.40",
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start --clear",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "build:dev": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit",
    "expo:fix": "expo install --check"
  },
  "dependencies": {
    "@activity-log/ui": "workspace:*",
    "@expo/ui": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@legendapp/list": "^2.0.14",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "date-fns": "4.1.0",
    "expo": "~57.0.19",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.16",
    "expo-blur": "^57.0.2",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-linking": "~57.0.9",
    "expo-localization": "57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "nativewind": "5.0.0-preview.4",
    "papaparse": "^5.4.1",
    "posthog-react-native": "^4.46.21",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-hook-form": "7.62.0",
    "react-native": "~0.86.3",
    "react-native-css": "3.0.7",
    "react-native-easing-gradient": "^1.1.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "~15.15.3",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.3.1",
    "uuid": "^14.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@activity-log/eslint-config": "workspace:*",
    "@activity-log/prettier-config": "workspace:*",
    "@activity-log/tailwind-config": "workspace:*",
    "@activity-log/tsconfig": "workspace:*",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native/metro-config": "0.86.3",
    "@types/lodash": "^4.17.16",
    "@types/papaparse": "^5.3.15",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "lightningcss": "1.30.1",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@activity-log/prettier-config",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
