{
  "name": "@activity-log/expo",
  "private": true,
  "version": "2.3.5",
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start --clear",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "build:dev": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "submit:ios": "APP_ENV=production eas submit --profile production --platform ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "expo:fix": "expo install --check"
  },
  "dependencies": {
    "@activity-log/ui": "workspace:*",
    "@expo/ui": "~58.0.30",
    "@expo/vector-icons": "^15.1.1",
    "@legendapp/list": "^3.3.11",
    "date-fns": "4.1.0",
    "expo": "~58.1.0",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.22",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.15",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.33",
    "expo-sharing": "~58.0.24",
    "expo-splash-screen": "~58.0.15",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.23",
    "lodash": "^4.17.21",
    "nativewind": "5.0.0-rc.1",
    "papaparse": "^5.4.1",
    "posthog-react-native": "^4.46.21",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-hook-form": "7.62.0",
    "react-native": "0.88.1",
    "react-native-css": "0.0.0-nightly.2e152c9",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "3.3.1",
    "uuid": "^14.0.2",
    "zod": "4.1.12",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@activity-log/eslint-config": "workspace:*",
    "@activity-log/prettier-config": "workspace:*",
    "@activity-log/tailwind-config": "workspace:*",
    "@activity-log/tsconfig": "workspace:*",
    "@babel/core": "7.29.13",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native/metro-config": "0.88.1",
    "@types/babel__core": "^7.20.5",
    "@types/lodash": "^4.17.16",
    "@types/papaparse": "^5.3.15",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@types/react-test-renderer": "19.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "18.0.8",
    "eslint": "catalog:",
    "lightningcss": "1.30.1",
    "prettier": "catalog:",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.0.15"
  },
  "prettier": "@activity-log/prettier-config",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
